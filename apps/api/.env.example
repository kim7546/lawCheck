# Railway API Variables reference. Add values in Railway, not in Git.
# The deployment entry point does not automatically load this file.
NODE_ENV=production
PORT=4000
LAW_OFFICE_NAME=법률사무소 IBS
OPENAI_API_KEY=
OPENAI_ANSWER_MODEL=gpt-4.1-mini
QUESTION_LIMIT_ENABLED=false
# Required when selecting railway.database.json. Use Railway's variable reference.
DATABASE_URL=
LAW_OFFICE_CODE=LAW001
# Optional one-time admin bootstrap (minimum 12-character password).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
