# Railway API Variables reference. See docs/railway-variables.md.
# Add values in Railway, not in Git. Use production even for a Railway development environment.
# The deployment entry point does not automatically load this file.
# Public API: https://api.aiqaver.com (Railway custom domain, Target port matches PORT).
NODE_ENV=production
PORT=4000
LAW_OFFICE_NAME=법률사무소 IBS
OPENAI_API_KEY=
OPENAI_ANSWER_MODEL=gpt-4.1-mini
QUESTION_LIMIT_ENABLED=false
# Required for the current API. Example in Railway: ${{Postgres.DATABASE_URL}}
# Use /apps/api/railway.database.json to apply migrations and seed before startup.
DATABASE_URL=
LAW_OFFICE_CODE=LAW001
# Optional platform admin: must be an existing, active BO member.
# Leave empty until BO signup in this environment's DB is complete.
# Missing BO account causes API startup to fail. Uses the existing BO password.
ADMIN_EMAIL=
# Legacy office staff seed (separate from the platform Admin account, minimum 12-character password).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
