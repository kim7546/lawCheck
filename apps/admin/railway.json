{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build -w @lawcheck/admin",
    "watchPatterns": [
      "/apps/admin/**",
      "/packages/ui/**",
      "/packages/contracts/**",
      "/packages/brand/**",
      "/package.json",
      "/package-lock.json",
      "/tsconfig.base.json",
      "/.nvmrc"
    ]
  },
  "deploy": {
    "startCommand": "npm run preview -w @lawcheck/admin",
    "healthcheckPath": "/admin",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
