# Browser-visible link to the FO service. Read at build time.
VITE_FO_URL=https://aiqaver.com
# Deployment runtime variables (set in the Admin service, not in the browser).
# Public URL: https://admin.aiqaver.com (both / and /admin are supported).
# API_PROXY_TARGET=https://your-api-service.example.com
# PORT=4175
# RAILWAY_PUBLIC_DOMAIN=your-admin-service.up.railway.app
# PREVIEW_ALLOWED_HOSTS=admin.aiqaver.com
# admin.aiqaver.com is already allowed; use PREVIEW_ALLOWED_HOSTS for extra domains.
# The preview config reads process environment variables, not this file.
