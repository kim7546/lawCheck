# Railway FO Variables reference. See docs/railway-variables.md.
# Replace example domains with services in the SAME Railway environment.
# Set runtime variables in Railway; preview does not load this file.
NODE_ENV=production
# Match the domain Target port; existing deployments may use 5173.
PORT=4173
API_PROXY_TARGET=https://your-api-service.example.com
# Browser-visible /admin redirect; origin only, without /admin. Rebuild after changing.
# Production: https://admin.aiqaver.com. Use the development Admin domain for development.
VITE_ADMIN_URL=https://your-admin-service.example.com
# Custom hostnames only, without scheme or path. For production: aiqaver.com,www.aiqaver.com
PREVIEW_ALLOWED_HOSTS=
# Railway supplies RAILWAY_PUBLIC_DOMAIN after a public domain is configured.
