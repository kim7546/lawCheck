{
  "name": "lawcheck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,FO,BO,ADMIN -c yellow,green,blue,magenta \"npm run dev -w @lawcheck/api\" \"npm run dev -w @lawcheck/fo\" \"npm run dev -w @lawcheck/bo\" \"npm run dev -w @lawcheck/admin\"",
    "dev:admin": "npm run dev -w @lawcheck/admin",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages tests",
    "format": "prettier --write apps packages tests scripts *.json *.ts *.js *.yml README.md .env.example",
    "format:check": "prettier --check apps packages tests scripts *.json *.ts *.js *.yml README.md",
    "test": "npm run test -w @lawcheck/api",
    "test:e2e": "playwright test",
    "test:admin-service": "npm run build -w @lawcheck/admin && node scripts/test-admin-service.mjs",
    "db:generate": "npm run db:generate -w @lawcheck/api",
    "codes:admin": "node apps/api/prisma/code-admin.mjs",
    "admin:account": "node apps/api/prisma/admin-account.mjs",
    "db:migrate": "npm run db:migrate -w @lawcheck/api",
    "db:migrate:dev": "npm run db:migrate:dev -w @lawcheck/api --",
    "db:seed": "npm run db:seed -w @lawcheck/api",
    "db:up": "docker compose up -d --wait postgres",
    "db:stop": "docker compose stop postgres",
    "db:logs": "docker compose logs --tail=100 -f postgres",
    "db:setup": "npm run db:generate && npm run db:deploy && npm run db:check",
    "db:deploy": "npm run db:deploy -w @lawcheck/api",
    "db:status": "npm run db:status -w @lawcheck/api",
    "db:validate": "npm run db:validate -w @lawcheck/api",
    "db:check": "npm run db:check -w @lawcheck/api",
    "db:studio": "npm run db:studio -w @lawcheck/api",
    "db:test": "npm run db:test -w @lawcheck/api",
    "test:db": "node scripts/test-database.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}
