NODE_ENV=development
# FO/BO/Admin search indexing: disabled unless explicitly true. Restart dev after changing.
# For deployment, set the same value at build and preview runtime, then rebuild/redeploy.
SEARCH_ENGINE_INDEXING_ENABLED=false
# Vite preview allowed domains. Set on the Railway FO service and redeploy.
PREVIEW_ALLOWED_HOSTS=aiqaver.com,www.aiqaver.com
# Local PostgreSQL container. Keep DATABASE_URL consistent with these settings.
POSTGRES_USER=lawcheck
POSTGRES_PASSWORD=lawcheck_local
POSTGRES_DB=lawcheck
POSTGRES_PORT=5432
# Optional platform admin: existing active BO member, uses the BO password.
ADMIN_EMAIL=
# Optional legacy office staff seed, separate from platform Admin. Set both or neither.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
QUESTION_LIMIT_ENABLED=false
PORT=4000
LAW_OFFICE_CODE=LAW001
LAW_OFFICE_NAME=법률사무소 IBS
DATABASE_URL=postgresql://lawcheck:lawcheck_local@localhost:5432/lawcheck?schema=public
# Server-only OpenAI credentials. Never expose the API key with a VITE_ prefix.
OPENAI_API_KEY=
OPENAI_CLASSIFIER_MODEL=
OPENAI_ANSWER_MODEL=gpt-6-sol
# Realtime voice input; requires the server OpenAI key and a working database.
# Set false to hide the microphone and reject voice session requests.
VOICE_INPUT_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
